{
  "name": "@yetric/audioplayer",
  "version": "1.3.0",
  "description": "Headless TypeScript audio player library for modern browsers.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "website"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "dev": "tsup --watch",
    "demo:start": "vite demo",
    "demo:build": "vite build demo --config demo/vite.config.js",
    "demo:preview": "vite preview demo",
    "docs:start": "npm run start --workspace website",
    "docs:build": "npm run build --workspace website",
    "docs:serve": "npm run serve --workspace website",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run src demo/story",
    "test:browser": "playwright test",
    "test:package": "node --test tests/package.test.mjs",
    "check:size": "node scripts/check-size.mjs",
    "example:react": "vite --open /examples/react/",
    "example:react:build": "vite build examples/react",
    "check:examples": "tsc --project tsconfig.examples.json"
  },
  "keywords": [
    "audio",
    "player",
    "podcast",
    "typescript",
    "browser"
  ],
  "author": "Yetric AB",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yetric/audioplayer.git"
  },
  "homepage": "https://github.com/yetric/audioplayer#readme",
  "bugs": {
    "url": "https://github.com/yetric/audioplayer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "^2.2.0"
    },
    "serialize-javascript": "^7.1.4",
    "express": {
      "qs": "^6.16.2"
    },
    "sockjs": {
      "uuid": "^11.1.1"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
